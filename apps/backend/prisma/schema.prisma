generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Minimal vertical slice: Just users and organizations

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String         @map("password_hash")
  firstName     String?        @map("first_name")
  lastName      String?        @map("last_name")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  
  // Relations
  organizations Organization[]  @relation("CreatedOrganizations")
  memberships   Membership[]
  activities    Activity[]      @relation("CreatedActivities")

  @@map("users")
}

model Organization {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  createdById String   @map("created_by_id")
  createdBy   User     @relation("CreatedOrganizations", fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  memberships Membership[]
  activities  Activity[]

  @@map("organizations")
}

model Membership {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  organizationId String   @map("organization_id")
  role           String   @default("member")
  status         String   @default("active")
  joinedAt       DateTime @default(now()) @map("joined_at")
  
  // Relations
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@map("memberships")
}

// Base table for all activities (events, tasks, meetings, etc.)
model Activity {
  id             String   @id @default(uuid())
  type           String   // 'event', 'task', 'meeting', etc.
  title          String
  description    String?
  organizationId String   @map("organization_id")
  createdById    String   @map("created_by_id")
  status         String   @default("draft") // draft, published, cancelled, completed
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("CreatedActivities", fields: [createdById], references: [id])
  event        Event?

  @@index([organizationId])
  @@index([type])
  @@index([status])
  @@map("activities")
}

// Events extend activities
model Event {
  id           String    @id @default(uuid())
  activityId   String    @unique @map("activity_id")
  startDate    DateTime  @map("start_date")
  endDate      DateTime? @map("end_date")
  venue        String?
  eventType    String    @default("general") @map("event_type") // general, workshop, seminar, competition, social
  maxAttendees Int?      @map("max_attendees")
  isPublic     Boolean   @default(true) @map("is_public")

  // Relations
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([startDate])
  @@index([eventType])
  @@map("events")
}
